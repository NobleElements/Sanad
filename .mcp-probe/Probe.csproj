<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>McpProbe</RootNamespace>
    <AssemblyName>mcpprobe</AssemblyName>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2104;IL3053</NoWarn>
    <_ExtraTrimmerArgs Condition="'$(DumpTrimFacts)' == 'true'">$(_ExtraTrimmerArgs) --dump-dependencies --dependencies-file $(MSBuildProjectDirectory)/trimfacts/deps.xml</_ExtraTrimmerArgs>
  </PropertyGroup>

  <PropertyGroup>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Sanad.Api/Sanad.Api.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DumpTrimFacts)' == 'true'">
    <TrimmerRootAssembly Include="Sanad.Api" RootMode="library" />
  </ItemGroup>

  <Target Name="DumpTrimmedReflectionFacts"
          AfterTargets="ILLink"
          Condition="'$(DumpTrimFacts)' == 'true'">
    <PropertyGroup>
      <_EmptyReflFile>$(IntermediateOutputPath)empty-reflection.xml</_EmptyReflFile>
      <_DescFile>$(IntermediateOutputPath)$(TargetName).trim-analysis.xml</_DescFile>
    </PropertyGroup>

  <PropertyGroup>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
    <WriteLinesToFile File="$(_EmptyReflFile)" Lines="&lt;linker&gt;&lt;/linker&gt;" Overwrite="true" />
    <Message Importance="high" Text="TRIM ANALYSIS FILE: $(_DescFile)" />
    <Copy SourceFiles="$(_DescFile)" DestinationFolder="$(MSBuildProjectDirectory)/trimfacts/" SkipUnchangedFiles="false" Condition="Exists('$(_DescFile)')" />
  </Target>

</Project>
